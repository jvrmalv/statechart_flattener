<scxml version="1.0" initial="main_Idle__currentFloor_0__destination_0" xmlns="http://www.w3.org/2005/07/scxml">
  <state id="main_Idle__currentFloor_0__destination_0">
    <transition target="main_Moving_MovingDown__currentFloor_0__destination_0" event="floor [_event.data &lt; currentFloor &amp;&amp; _event.data &gt;= 0]"/>
    <transition target="main_Moving_MovingUp__currentFloor_0__destination_0" event="floor [_event.data > currentFloor]"/>
  </state>
  <state id="main_Moving_MovingDown__currentFloor_0__destination_0">
    <transition target="main_Idle__currentFloor_0__destination_0" event="_auto"/>
  </state>
  <state id="main_Moving_MovingUp__currentFloor_0__destination_0">
    <transition target="main_Idle__currentFloor_0__destination_0" event="_auto"/>
  </state>
</scxml>