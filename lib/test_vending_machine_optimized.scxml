<scxml version="1.0" initial="machine_Idle__coins_0__hasProduct_false" xmlns="http://www.w3.org/2005/07/scxml">
  <state id="machine_Accepting__coins_1__hasProduct_false">
    <transition target="machine_Idle__coins_0__hasProduct_false" event="cancel"/>
    <transition target="machine_Accepting__coins_2__hasProduct_false" event="insertCoin"/>
  </state>
  <state id="machine_Accepting__coins_2__hasProduct_false">
    <transition target="machine_Idle__coins_0__hasProduct_false" event="cancel"/>
    <transition target="machine_Accepting__coins_3__hasProduct_false" event="insertCoin"/>
    <transition target="machine_Dispensing__coins_2__hasProduct_true" event="select">
      <send event="productReady"/>
    </transition>
  </state>
  <state id="machine_Accepting__coins_3__hasProduct_false">
    <transition target="machine_Idle__coins_0__hasProduct_false" event="cancel"/>
    <transition target="machine_Dispensing__coins_3__hasProduct_true" event="select">
      <send event="productReady"/>
    </transition>
  </state>
  <state id="machine_Dispensing__coins_2__hasProduct_true">
    <transition target="machine_Idle__coins_0__hasProduct_false" event="take"/>
  </state>
  <state id="machine_Dispensing__coins_3__hasProduct_true">
    <transition target="machine_Idle__coins_0__hasProduct_false" event="take"/>
  </state>
  <state id="machine_Idle__coins_0__hasProduct_false">
    <transition target="machine_Accepting__coins_1__hasProduct_false" event="insertCoin"/>
  </state>
</scxml>